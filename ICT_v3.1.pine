// =============================================================================
// ICT CONCEPTS INDICATOR v3.1 — Pine Script v5
// MAJOR REFACTOR from v3.0:
//   ✦ Core + Confluence entry model (replaces rigid 6-point scoring)
//   ✦ Dynamic Liquidity TP (targets nearest swing high/EQH or swing low/EQL)
//   ✦ Smart Trailing Stop: BE at 1R, trail on new MSS
//   ✦ ATR Volatility / Choppiness Filter (no signals in dead markets)
//   ✦ Full Dashboard: Win Rate, Streaks, R:R Report
// =============================================================================

//@version=5
indicator("ICT Suite v3.1 [Core+Confluence | DynTP]", overlay=true,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =============================================================================
// ─── INPUTS ──────────────────────────────────────────────────────────────────
// =============================================================================

// ── Order Blocks ──────────────────────────────────────────────────────────────
grpOB        = "① Order Blocks"
showOB       = input.bool(true,  "Show Order Blocks",           group=grpOB)
obLookback   = input.int(10,     "OB Lookback (bars)", minval=3, group=grpOB)
colorBullOB  = input.color(color.new(#00bcd4, 72), "Bullish OB", group=grpOB)
colorBearOB  = input.color(color.new(#ff5722, 72), "Bearish OB", group=grpOB)
obBorderBull = input.color(color.new(#00bcd4, 20), "Bull Border", group=grpOB)
obBorderBear = input.color(color.new(#ff5722, 20), "Bear Border", group=grpOB)

// ── Fair Value Gaps ───────────────────────────────────────────────────────────
grpFVG       = "② Fair Value Gaps"
showFVG      = input.bool(true,  "Show FVGs",                   group=grpFVG)
extendFVG    = input.bool(true,  "Extend Until Filled",         group=grpFVG)
colorBullFVG = input.color(color.new(#4caf50, 80), "Bullish FVG", group=grpFVG)
colorBearFVG = input.color(color.new(#f44336, 80), "Bearish FVG", group=grpFVG)
fvgBordBull  = input.color(color.new(#4caf50, 30), "Bull Border", group=grpFVG)
fvgBordBear  = input.color(color.new(#f44336, 30), "Bear Border", group=grpFVG)

// ── Market Structure ──────────────────────────────────────────────────────────
grpMSS       = "③ Market Structure BOS/MSS"
showMSS      = input.bool(true,  "Show BOS / MSS",              group=grpMSS)
swingLen     = input.int(10,     "Swing Length", minval=2,       group=grpMSS)
colorBOS     = input.color(color.new(#2196f3, 0), "BOS Color",  group=grpMSS)
colorMSS_in  = input.color(color.new(#ff9800, 0), "MSS Color",  group=grpMSS)
showBOSLine  = input.bool(true,  "Show Dashed Line",            group=grpMSS)

// ── Liquidity Zones ───────────────────────────────────────────────────────────
grpLIQ       = "④ Liquidity Zones EQH/EQL"
showLIQ      = input.bool(true,  "Show Liquidity Zones",        group=grpLIQ)
liqLen       = input.int(10,     "Pivot Length", minval=3,      group=grpLIQ)
liqThresh    = input.float(0.05, "Equal Level Threshold %", minval=0.01, step=0.01, group=grpLIQ)
colorEQH     = input.color(color.new(#e91e63, 60), "EQH Color", group=grpLIQ)
colorEQL     = input.color(color.new(#9c27b0, 60), "EQL Color", group=grpLIQ)

// ── Premium & Discount ────────────────────────────────────────────────────────
grpPD        = "⑤ Premium & Discount"
showPD       = input.bool(true,  "Show Premium/Discount",       group=grpPD)
pdLen        = input.int(50,     "Range Lookback", minval=10,   group=grpPD)
colorPremium = input.color(color.new(#f44336, 90), "Premium Zone", group=grpPD)
colorDisc    = input.color(color.new(#4caf50, 90), "Discount Zone", group=grpPD)
colorEquilib = input.color(color.new(#ffeb3b, 0),  "Equilibrium",  group=grpPD)

// ── Killzones ─────────────────────────────────────────────────────────────────
grpKZ        = "⑥ Killzones"
showKZ       = input.bool(true,  "Show Killzones",              group=grpKZ)
colorAsian   = input.color(color.new(#607d8b, 88), "Asian Session", group=grpKZ)
colorLondon  = input.color(color.new(#3f51b5, 88), "London Open",   group=grpKZ)
colorNY      = input.color(color.new(#009688, 88), "New York Open",  group=grpKZ)

// ── Breaker Blocks ────────────────────────────────────────────────────────────
grpBB        = "⑦ Breaker Blocks"
showBB       = input.bool(true,  "Show Breaker Blocks",         group=grpBB)
colorBullBB  = input.color(color.new(#00e676, 70), "Bullish BB", group=grpBB)
colorBearBB  = input.color(color.new(#ff1744, 70), "Bearish BB", group=grpBB)

// ── Inducement ────────────────────────────────────────────────────────────────
grpIDM       = "⑧ Inducement IDM"
showIDM      = input.bool(true,  "Show Inducement Levels",      group=grpIDM)
idmLen       = input.int(5,      "IDM Pivot Length", minval=2,  group=grpIDM)
colorIDM     = input.color(color.new(#ff9800, 0), "IDM Color",  group=grpIDM)

// ── HTF Confluence ────────────────────────────────────────────────────────────
grpHTF       = "⑨ HTF Confluence"
showHTF      = input.bool(false, "Show HTF OB/FVG",             group=grpHTF)
htfTF        = input.timeframe("60", "Higher Timeframe",        group=grpHTF)
colorHTFBull = input.color(color.new(#00bcd4, 88), "HTF Bull",  group=grpHTF)
colorHTFBear = input.color(color.new(#ff5722, 88), "HTF Bear",  group=grpHTF)

// ── Entry Signal Settings (v3.1 REFACTORED) ───────────────────────────────────
grpSIG       = "⑩ Entry Signals [v3.1]"
showSignals  = input.bool(true, "Show Entry Signals",           group=grpSIG)
slMulti      = input.float(1.5, "SL ATR Multiplier", minval=0.5, step=0.25, group=grpSIG)
minRR        = input.float(1.5, "Minimum R:R (Dynamic TP floor)", minval=1.0, step=0.25, group=grpSIG)
tpLookback   = input.int(30,   "Dynamic TP Lookback (bars)", minval=10, maxval=100, group=grpSIG)
colorBuySignal  = input.color(color.new(#00e676, 0), "BUY Signal Color",  group=grpSIG)
colorSellSignal = input.color(color.new(#ff1744, 0), "SELL Signal Color", group=grpSIG)
showSLTP     = input.bool(true, "Show SL/TP Lines",             group=grpSIG)

// ── Volatility Filter ─────────────────────────────────────────────────────────
grpVOL       = "⑪ Volatility Filter"
useVolFilter = input.bool(true,  "Enable ATR Volatility Filter",   group=grpVOL)
atrFilterLen = input.int(20,     "ATR MA Length (trend reference)", group=grpVOL, minval=5)
atrFilterMul = input.float(0.75, "Min ATR vs MA ratio (0.75 = 75% of avg)", group=grpVOL, minval=0.1, step=0.05)

// ── Dashboard ─────────────────────────────────────────────────────────────────
grpDB        = "⑫ Dashboard"
showDB       = input.bool(true, "Show Dashboard",               group=grpDB)
dbPos        = input.string("Bottom Right", "Position",
     options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grpDB)

// =============================================================================
// ─── PIVOT HELPERS ───────────────────────────────────────────────────────────
// =============================================================================

pivotHigh(len) => ta.pivothigh(high, len, len)
pivotLow(len)  => ta.pivotlow(low,  len, len)

// =============================================================================
// ─── TOP-LEVEL CALCULATIONS (ta.* must be at root scope) ─────────────────────
// =============================================================================

highestHigh = ta.highest(high, obLookback)[1]
lowestLow   = ta.lowest(low,  obLookback)[1]
pdHighest   = ta.highest(high, pdLen)
pdLowest    = ta.lowest(low,  pdLen)
atrValue    = ta.atr(14)

// ATR Volatility filter: is current ATR healthy vs its own moving average?
atrMA       = ta.sma(atrValue, atrFilterLen)
isVolatile  = not useVolFilter or (atrValue >= atrMA * atrFilterMul)

// Dynamic TP: track recent swing highs/lows for liquidity targeting
recentSwingH = ta.highest(high, tpLookback)   // opposing target for sells
recentSwingL = ta.lowest(low,  tpLookback)    // opposing target for buys

// =============================================================================
// ─── 1. FAIR VALUE GAPS ───────────────────────────────────────────────────────
// =============================================================================

var fvgBoxes   = array.new_box()
var fvgIsBull  = array.new_bool()
var fvgTopArr  = array.new_float()
var fvgBotArr  = array.new_float()
var int fvgCount = 0

if showFVG and barstate.isconfirmed
    bullFVG = low[1] > high[3]
    bearFVG = high[1] < low[3]

    if bullFVG
        b = box.new(bar_index - 2, high[3], bar_index + 1, low[1],
             border_color=fvgBordBull, bgcolor=colorBullFVG)
        array.push(fvgBoxes, b)
        array.push(fvgIsBull, true)
        array.push(fvgTopArr, low[1])
        array.push(fvgBotArr, high[3])
        fvgCount += 1

    if bearFVG
        b = box.new(bar_index - 2, high[1], bar_index + 1, low[3],
             border_color=fvgBordBear, bgcolor=colorBearFVG)
        array.push(fvgBoxes, b)
        array.push(fvgIsBull, false)
        array.push(fvgTopArr, high[1])
        array.push(fvgBotArr, low[3])
        fvgCount += 1

var bool  inBullFVG    = false
var bool  inBearFVG    = false
var float activeFVGTop = na
var float activeFVGBot = na

inBullFVG := false
inBearFVG := false

if array.size(fvgBoxes) > 0
    for i = array.size(fvgBoxes) - 1 to 0
        b      = array.get(fvgBoxes, i)
        isBull = array.get(fvgIsBull, i)
        bTop   = box.get_top(b)
        bBot   = box.get_bottom(b)
        filled = isBull ? low <= bBot : high >= bTop

        if close >= bBot and close <= bTop
            if isBull
                inBullFVG    := true
                activeFVGTop := bTop
                activeFVGBot := bBot
            else
                inBearFVG    := true
                activeFVGTop := bTop
                activeFVGBot := bBot

        if filled
            array.remove(fvgBoxes, i)
            array.remove(fvgIsBull, i)
            array.remove(fvgTopArr, i)
            array.remove(fvgBotArr, i)
            fvgCount := math.max(fvgCount - 1, 0)
        else if showFVG and extendFVG
            box.set_right(b, bar_index + 1)

// =============================================================================
// ─── 2. ORDER BLOCKS + BREAKER BLOCKS ────────────────────────────────────────
// =============================================================================

var obBoxes     = array.new_box()
var obIsBull    = array.new_bool()
var obMitigated = array.new_bool()
var obTopArr    = array.new_float()
var obBotArr    = array.new_float()
var int obCount = 0

strongBull = close > highestHigh and close[1] < open[1]
strongBear = close < lowestLow   and close[1] > open[1]

if showOB and barstate.isconfirmed
    if strongBull
        obTop = math.max(open[1], close[1])
        obBot = math.min(open[1], close[1])
        b = box.new(bar_index - 1, obTop, bar_index + 1, obBot,
             border_color=obBorderBull, bgcolor=colorBullOB)
        array.push(obBoxes, b)
        array.push(obIsBull, true)
        array.push(obMitigated, false)
        array.push(obTopArr, obTop)
        array.push(obBotArr, obBot)
        obCount += 1

    if strongBear
        obTop = math.max(open[1], close[1])
        obBot = math.min(open[1], close[1])
        b = box.new(bar_index - 1, obTop, bar_index + 1, obBot,
             border_color=obBorderBear, bgcolor=colorBearOB)
        array.push(obBoxes, b)
        array.push(obIsBull, false)
        array.push(obMitigated, false)
        array.push(obTopArr, obTop)
        array.push(obBotArr, obBot)
        obCount += 1

var bool  inBullOB   = false
var bool  inBearOB   = false
var float activeOBTop = na
var float activeOBBot = na

inBullOB := false
inBearOB := false

if (showOB or showBB) and array.size(obBoxes) > 0
    for i = array.size(obBoxes) - 1 to 0
        b      = array.get(obBoxes, i)
        isBull = array.get(obIsBull, i)
        isMit  = array.get(obMitigated, i)
        bTop   = box.get_top(b)
        bBot   = box.get_bottom(b)
        mid    = (bTop + bBot) / 2

        if not isMit and close >= bBot and close <= bTop
            if isBull
                inBullOB   := true
                activeOBTop := bTop
                activeOBBot := bBot
            else
                inBearOB   := true
                activeOBTop := bTop
                activeOBBot := bBot

        mitigated = isBull ? low < mid : high > mid

        if mitigated and not isMit
            array.set(obMitigated, i, true)
            obCount := math.max(obCount - 1, 0)
            if showBB
                newBg     = isBull ? colorBearBB : colorBullBB
                newBorder = isBull ? color.new(#ff1744, 20) : color.new(#00e676, 20)
                box.set_bgcolor(b, newBg)
                box.set_border_color(b, newBorder)
            else
                array.remove(obBoxes, i)
                array.remove(obIsBull, i)
                array.remove(obMitigated, i)
                array.remove(obTopArr, i)
                array.remove(obBotArr, i)
        else if not isMit
            box.set_right(b, bar_index + 1)

// =============================================================================
// ─── 3. MARKET STRUCTURE — BOS / MSS ─────────────────────────────────────────
// =============================================================================

var float lastSwingH    = na
var float lastSwingL    = na
var int   lastSHBar     = na
var int   lastSLBar     = na
var int   trend         = 0
var int   mssCount      = 0
var int   bosCount      = 0
var bool  recentMSSBull = false   // MSS bullish within last 20 bars
var bool  recentMSSBear = false
var int   mssBullBar    = 0
var int   mssBearBar    = 0

ph = pivotHigh(swingLen)
pl = pivotLow(swingLen)

if not na(ph)
    lastSwingH := ph
    lastSHBar  := bar_index - swingLen

if not na(pl)
    lastSwingL := pl
    lastSLBar  := bar_index - swingLen

bosBull   = not na(lastSwingH) and close[1] > lastSwingH and close[2] <= lastSwingH
bosBear   = not na(lastSwingL) and close[1] < lastSwingL and close[2] >= lastSwingL
isMSSBull = bosBull and trend == -1
isMSSBear = bosBear and trend ==  1

if bosBull
    trend := 1
    if isMSSBull
        mssCount    += 1
        recentMSSBull := true
        mssBullBar    := bar_index
    else
        bosCount += 1

if bosBear
    trend := -1
    if isMSSBear
        mssCount    += 1
        recentMSSBear := true
        mssBearBar    := bar_index
    else
        bosCount += 1

// Reset MSS flags after 20 bars
if bar_index - mssBullBar > 20
    recentMSSBull := false
if bar_index - mssBearBar > 20
    recentMSSBear := false

if showMSS and barstate.isconfirmed
    if bosBull
        lvl = lastSwingH
        lbl = isMSSBull ? "MSS" : "BOS"
        clr = isMSSBull ? colorMSS_in : colorBOS
        if showBOSLine
            line.new(lastSHBar, lvl, bar_index, lvl,
                 color=clr, width=1, style=line.style_dashed)
        label.new(bar_index, lvl, lbl,
             color=color.new(clr, 85), textcolor=clr,
             style=label.style_label_down, size=size.small)

    if bosBear
        lvl = lastSwingL
        lbl = isMSSBear ? "MSS" : "BOS"
        clr = isMSSBear ? colorMSS_in : colorBOS
        if showBOSLine
            line.new(lastSLBar, lvl, bar_index, lvl,
                 color=clr, width=1, style=line.style_dashed)
        label.new(bar_index, lvl, lbl,
             color=color.new(clr, 85), textcolor=clr,
             style=label.style_label_up, size=size.small)

plotshape(showMSS and not na(ph) ? ph : na,
     title="Swing High", style=shape.circle, location=location.abovebar,
     color=color.new(colorBOS, 40), size=size.tiny)
plotshape(showMSS and not na(pl) ? pl : na,
     title="Swing Low", style=shape.circle, location=location.belowbar,
     color=color.new(colorBOS, 40), size=size.tiny)

// =============================================================================
// ─── 4. LIQUIDITY ZONES — EQH / EQL ─────────────────────────────────────────
// =============================================================================

var float prevPH    = na
var int   prevPHBar = na
var float prevPL    = na
var int   prevPLBar = na
var int   liqCount  = 0

var bool recentEQHSweep = false
var bool recentEQLSweep = false
var int  eqhSweepBar    = 0
var int  eqlSweepBar    = 0

// Store EQH/EQL levels for dynamic TP targeting
var float nearestEQH = na
var float nearestEQL = na

liqPH = pivotHigh(liqLen)
liqPL = pivotLow(liqLen)

if barstate.isconfirmed
    if not na(liqPH)
        if not na(prevPH)
            pct = math.abs(liqPH - prevPH) / prevPH * 100
            if pct <= liqThresh
                if showLIQ
                    line.new(prevPHBar, prevPH, bar_index - liqLen, liqPH,
                         color=colorEQH, width=1, style=line.style_dotted)
                    label.new(bar_index - liqLen, liqPH, "EQH",
                         color=color.new(colorEQH, 80), textcolor=colorEQH,
                         style=label.style_label_left, size=size.tiny)
                liqCount += 1
                nearestEQH := liqPH
                if high >= liqPH
                    recentEQHSweep := true
                    eqhSweepBar    := bar_index
        prevPH    := liqPH
        prevPHBar := bar_index - liqLen

    if not na(liqPL)
        if not na(prevPL)
            pct = math.abs(liqPL - prevPL) / prevPL * 100
            if pct <= liqThresh
                if showLIQ
                    line.new(prevPLBar, prevPL, bar_index - liqLen, liqPL,
                         color=colorEQL, width=1, style=line.style_dotted)
                    label.new(bar_index - liqLen, liqPL, "EQL",
                         color=color.new(colorEQL, 80), textcolor=colorEQL,
                         style=label.style_label_left, size=size.tiny)
                liqCount += 1
                nearestEQL := liqPL
                if low <= liqPL
                    recentEQLSweep := true
                    eqlSweepBar    := bar_index
        prevPL    := liqPL
        prevPLBar := bar_index - liqLen

// Reset sweep flags after 15 bars (extended from v3 for better confluence window)
if bar_index - eqhSweepBar > 15
    recentEQHSweep := false
if bar_index - eqlSweepBar > 15
    recentEQLSweep := false

// =============================================================================
// ─── 5. PREMIUM & DISCOUNT ZONES ─────────────────────────────────────────────
// =============================================================================

var box   premBox   = na
var box   discBox   = na
var line  equilLine = na
var label premLbl   = na
var label discLbl   = na
var label equilLbl  = na

equil      = (pdHighest + pdLowest) / 2
inDiscount = close < equil
inPremium  = close > equil

if showPD and barstate.islast
    if not na(premBox)   box.delete(premBox)
    if not na(discBox)   box.delete(discBox)
    if not na(equilLine) line.delete(equilLine)
    if not na(premLbl)   label.delete(premLbl)
    if not na(discLbl)   label.delete(discLbl)
    if not na(equilLbl)  label.delete(equilLbl)

    premBox   := box.new(bar_index - pdLen, pdHighest, bar_index + 5, equil,
         border_color=color.new(#f44336, 60), bgcolor=colorPremium)
    discBox   := box.new(bar_index - pdLen, equil, bar_index + 5, pdLowest,
         border_color=color.new(#4caf50, 60), bgcolor=colorDisc)
    equilLine := line.new(bar_index - pdLen, equil, bar_index + 5, equil,
         color=colorEquilib, width=1, style=line.style_dashed)
    premLbl   := label.new(bar_index + 3, pdHighest, "Premium",
         color=color.new(#f44336, 80), textcolor=#f44336,
         style=label.style_label_left, size=size.tiny)
    discLbl   := label.new(bar_index + 3, pdLowest,  "Discount",
         color=color.new(#4caf50, 80), textcolor=#4caf50,
         style=label.style_label_left, size=size.tiny)
    equilLbl  := label.new(bar_index + 3, equil, "EQ 50%",
         color=color.new(#ffeb3b, 80), textcolor=#ffeb3b,
         style=label.style_label_left, size=size.tiny)

// =============================================================================
// ─── 6. KILLZONES ────────────────────────────────────────────────────────────
// =============================================================================

inAsian    = showKZ and not na(time(timeframe.period, "2000-0000", "UTC+0"))
inLondon   = showKZ and not na(time(timeframe.period, "0200-0500", "UTC+0"))
inNY       = showKZ and not na(time(timeframe.period, "0700-1000", "UTC+0"))
inKillzone = inLondon or inNY

bgcolor(inAsian  ? colorAsian  : na, title="Asian Session BG")
bgcolor(inLondon ? colorLondon : na, title="London Open BG")
bgcolor(inNY     ? colorNY     : na, title="New York Open BG")

// =============================================================================
// ─── 7. BREAKER BLOCKS (Managed within OB section) ───────────────────────────
// =============================================================================

// =============================================================================
// ─── 8. INDUCEMENT (IDM) ─────────────────────────────────────────────────────
// =============================================================================

idmPH = pivotHigh(idmLen)
idmPL = pivotLow(idmLen)

if showIDM and barstate.isconfirmed
    if not na(idmPH) and not na(lastSwingH)
        if idmPH < lastSwingH
            line.new(bar_index - idmLen, idmPH, bar_index, idmPH,
                 color=colorIDM, width=1, style=line.style_dotted)
            label.new(bar_index - idmLen, idmPH, "IDM",
                 color=color.new(colorIDM, 80), textcolor=colorIDM,
                 style=label.style_label_right, size=size.tiny)

    if not na(idmPL) and not na(lastSwingL)
        if idmPL > lastSwingL
            line.new(bar_index - idmLen, idmPL, bar_index, idmPL,
                 color=colorIDM, width=1, style=line.style_dotted)
            label.new(bar_index - idmLen, idmPL, "IDM",
                 color=color.new(colorIDM, 80), textcolor=colorIDM,
                 style=label.style_label_right, size=size.tiny)

// =============================================================================
// ─── 9. HTF CONFLUENCE ───────────────────────────────────────────────────────
// =============================================================================

[htfC, htfO, htfH, htfL] = request.security(syminfo.tickerid, htfTF,
     [close[1], open[1], high[1], low[1]], lookahead=barmerge.lookahead_off)

htfBullOB  = showHTF and htfC > htfO  and htfC[1] < htfO[1]
htfBearOB  = showHTF and htfC < htfO  and htfC[1] > htfO[1]
htfBullFVG = showHTF and htfL > htfH[2]
htfBearFVG = showHTF and htfH < htfL[2]

htfBullBias = htfC > htfO   // current HTF candle bullish
htfBearBias = htfC < htfO

if showHTF and barstate.isconfirmed
    if htfBullOB
        box.new(bar_index - 3, htfH[1], bar_index + 10, htfL[1],
             border_color=color.new(colorHTFBull, 40), bgcolor=colorHTFBull)
        label.new(bar_index, htfH[1], "HTF OB",
             color=color.new(colorHTFBull, 70), textcolor=colorHTFBull,
             style=label.style_label_down, size=size.tiny)

    if htfBearOB
        box.new(bar_index - 3, htfH[1], bar_index + 10, htfL[1],
             border_color=color.new(colorHTFBear, 40), bgcolor=colorHTFBear)
        label.new(bar_index, htfL[1], "HTF OB",
             color=color.new(colorHTFBear, 70), textcolor=colorHTFBear,
             style=label.style_label_up, size=size.tiny)

    if htfBullFVG
        box.new(bar_index - 2, htfH[2], bar_index + 10, htfL,
             border_color=color.new(colorHTFBull, 50),
             bgcolor=color.new(colorHTFBull, 92))
        label.new(bar_index, htfH[2], "HTF FVG",
             color=color.new(colorHTFBull, 70), textcolor=colorHTFBull,
             style=label.style_label_down, size=size.tiny)

    if htfBearFVG
        box.new(bar_index - 2, htfH, bar_index + 10, htfL[2],
             border_color=color.new(colorHTFBear, 50),
             bgcolor=color.new(colorHTFBear, 92))
        label.new(bar_index, htfL[2], "HTF FVG",
             color=color.new(colorHTFBear, 70), textcolor=colorHTFBear,
             style=label.style_label_up, size=size.tiny)

// =============================================================================
// ─── 10. ENTRY SIGNAL ENGINE v3.1 — Core + Confluence Model ──────────────────
// =============================================================================
//
//  CORE (BOTH must be true to even consider a signal):
//    A) Price is inside an unmitigated Bullish/Bearish FVG OR Order Block
//    B) Currently within London or NY Killzone
//    C) ATR Volatility filter passes (market is not dead/choppy)
//
//  CONFLUENCE (at least 1 of 3 must be true):
//    X) HTF Bias aligns with trade direction
//    Y) Recent Liquidity Sweep in trade direction (EQL swept → BUY, EQH swept → SELL)
//    Z) Recent Market Structure Shift (MSS) in trade direction
//
//  Signal fires when: CORE satisfied AND CONFLUENCE ≥ 1
//  No more rigid 6-point system — this guarantees trades fire while still
//  requiring meaningful confluence.
//
// =============================================================================

// ── BUY Core ──────────────────────────────────────────────────────────────────
buyCore_Zone      = inBullOB or inBullFVG       // price in bullish demand zone
buyCore_Session   = inKillzone                   // killzone active
buyCore_Volatile  = isVolatile                   // market moving

buyCore = buyCore_Zone and buyCore_Session and buyCore_Volatile

// ── BUY Confluence (need ≥ 1) ─────────────────────────────────────────────────
buyCX = htfBullBias                // X: HTF bullish
buyCY = recentEQLSweep             // Y: sell-side liquidity swept → buy reversal
buyCZ = recentMSSBull              // Z: MSS bullish (trend shift up)

buyConfluenceCount = (buyCX ? 1 : 0) + (buyCY ? 1 : 0) + (buyCZ ? 1 : 0)
buyConfluence      = buyConfluenceCount >= 1

// ── SELL Core ─────────────────────────────────────────────────────────────────
selCore_Zone      = inBearOB or inBearFVG
selCore_Session   = inKillzone
selCore_Volatile  = isVolatile

selCore = selCore_Zone and selCore_Session and selCore_Volatile

// ── SELL Confluence (need ≥ 1) ────────────────────────────────────────────────
selCX = htfBearBias
selCY = recentEQHSweep
selCZ = recentMSSBear

selConfluenceCount = (selCX ? 1 : 0) + (selCY ? 1 : 0) + (selCZ ? 1 : 0)
selConfluence      = selConfluenceCount >= 1

// ── Final signal conditions ────────────────────────────────────────────────────
buySignalRaw = showSignals and barstate.isconfirmed and buyCore and buyConfluence
selSignalRaw = showSignals and barstate.isconfirmed and selCore and selConfluence

// Prevent duplicate back-to-back signals in same zone
var bool lastWasBuy  = false
var bool lastWasSell = false

buySignalFinal = buySignalRaw and not lastWasBuy
selSignalFinal = selSignalRaw and not lastWasSell

if buySignalFinal
    lastWasBuy  := true
    lastWasSell := false
if selSignalFinal
    lastWasSell := true
    lastWasBuy  := false
if not buySignalRaw and not selSignalRaw
    lastWasBuy  := false
    lastWasSell := false

// =============================================================================
// ─── 11. DYNAMIC LIQUIDITY TP CALCULATION ────────────────────────────────────
// =============================================================================
// TP targets the nearest opposing liquidity pool (swing high for buys, low for sells).
// If nearest EQH/EQL exists and is closer than the recent swing, prefer EQH/EQL.
// Minimum enforced RR = minRR input (default 1.5).
// =============================================================================

calcBuyTP(entryPx, slPx) =>
    rUnit     = entryPx - slPx
    minTP     = entryPx + rUnit * minRR          // floor at minRR
    // Nearest opposing target: recent swing high or EQH (whichever is closer above entry)
    tgt1      = recentSwingH                      // recent high (potential TP)
    tgt2      = not na(nearestEQH) and nearestEQH > entryPx ? nearestEQH : na
    bestTgt   = not na(tgt2) and (not na(tgt1)) ? math.min(tgt1, tgt2) : not na(tgt2) ? tgt2 : tgt1
    finalTP   = not na(bestTgt) and bestTgt > minTP ? bestTgt : minTP
    finalTP

calcSellTP(entryPx, slPx) =>
    rUnit     = slPx - entryPx
    minTP     = entryPx - rUnit * minRR
    tgt1      = recentSwingL
    tgt2      = not na(nearestEQL) and nearestEQL < entryPx ? nearestEQL : na
    bestTgt   = not na(tgt2) and (not na(tgt1)) ? math.max(tgt1, tgt2) : not na(tgt2) ? tgt2 : tgt1
    finalTP   = not na(bestTgt) and bestTgt < minTP ? bestTgt : minTP
    finalTP

// =============================================================================
// ─── 12. SIGNAL LABELS + SL/TP LINES ─────────────────────────────────────────
// =============================================================================

buildBuyTip(cX, cY, cZ) =>
    "BUY [Core+Confluence]\n" +
     "✦ Zone: " + (buyCore_Zone ? "✅ Bull OB/FVG" : "❌") + "\n" +
     "✦ Session: " + (inKillzone ? "✅ Killzone" : "❌") + "\n" +
     "✦ Volatility: " + (isVolatile ? "✅ Active" : "❌ Choppy") + "\n" +
     "── Confluence ──\n" +
     "X HTF Bias: " + (cX ? "✅ Bullish" : "—") + "\n" +
     "Y Liq Sweep: " + (cY ? "✅ EQL Swept" : "—") + "\n" +
     "Z MSS: " + (cZ ? "✅ Bull MSS" : "—")

buildSellTip(cX, cY, cZ) =>
    "SELL [Core+Confluence]\n" +
     "✦ Zone: " + (selCore_Zone ? "✅ Bear OB/FVG" : "❌") + "\n" +
     "✦ Session: " + (inKillzone ? "✅ Killzone" : "❌") + "\n" +
     "✦ Volatility: " + (isVolatile ? "✅ Active" : "❌ Choppy") + "\n" +
     "── Confluence ──\n" +
     "X HTF Bias: " + (cX ? "✅ Bearish" : "—") + "\n" +
     "Y Liq Sweep: " + (cY ? "✅ EQH Swept" : "—") + "\n" +
     "Z MSS: " + (cZ ? "✅ Bear MSS" : "—")

// Persist signal prices for the tracker
var float sigBuySL = na
var float sigBuyTP = na
var float sigSelSL = na
var float sigSelTP = na

if buySignalFinal
    sigBuySL := low - atrValue * slMulti
    sigBuyTP := calcBuyTP(close, sigBuySL)
    actualRR  = (sigBuyTP - close) / (close - sigBuySL)

    label.new(bar_index, low,
         "BUY ▲ " + str.tostring(buyConfluenceCount) + "/3",
         tooltip=buildBuyTip(buyCX, buyCY, buyCZ),
         color=color.new(colorBuySignal, 10), textcolor=color.white,
         style=label.style_label_up, size=size.normal)

    if showSLTP
        line.new(bar_index, sigBuySL, bar_index + 15, sigBuySL,
             color=color.new(#f44336, 30), width=1, style=line.style_dashed)
        label.new(bar_index + 15, sigBuySL,
             "SL " + str.tostring(math.round(sigBuySL, 5)),
             color=color.new(#f44336, 70), textcolor=#f44336,
             style=label.style_label_left, size=size.tiny)
        line.new(bar_index, sigBuyTP, bar_index + 15, sigBuyTP,
             color=color.new(#4caf50, 30), width=1, style=line.style_dashed)
        label.new(bar_index + 15, sigBuyTP,
             "TP " + str.tostring(math.round(sigBuyTP, 5)) +
             "  [" + str.tostring(math.round(actualRR, 1)) + "R]",
             color=color.new(#4caf50, 70), textcolor=#4caf50,
             style=label.style_label_left, size=size.tiny)

if selSignalFinal
    sigSelSL := high + atrValue * slMulti
    sigSelTP := calcSellTP(close, sigSelSL)
    actualRR  = (close - sigSelTP) / (sigSelSL - close)

    label.new(bar_index, high,
         "SELL ▼ " + str.tostring(selConfluenceCount) + "/3",
         tooltip=buildSellTip(selCX, selCY, selCZ),
         color=color.new(colorSellSignal, 10), textcolor=color.white,
         style=label.style_label_down, size=size.normal)

    if showSLTP
        line.new(bar_index, sigSelSL, bar_index + 15, sigSelSL,
             color=color.new(#f44336, 30), width=1, style=line.style_dashed)
        label.new(bar_index + 15, sigSelSL,
             "SL " + str.tostring(math.round(sigSelSL, 5)),
             color=color.new(#f44336, 70), textcolor=#f44336,
             style=label.style_label_left, size=size.tiny)
        line.new(bar_index, sigSelTP, bar_index + 15, sigSelTP,
             color=color.new(#4caf50, 30), width=1, style=line.style_dashed)
        label.new(bar_index + 15, sigSelTP,
             "TP " + str.tostring(math.round(sigSelTP, 5)) +
             "  [" + str.tostring(math.round(actualRR, 1)) + "R]",
             color=color.new(#4caf50, 70), textcolor=#4caf50,
             style=label.style_label_left, size=size.tiny)

// =============================================================================
// ─── 13. WIN RATE TRACKER + SMART TRAILING (BE at 1R, Trail on MSS) ──────────
// =============================================================================

var int   totalSignals      = 0
var int   totalWins         = 0
var int   totalLosses       = 0
var int   tradeState        = 0       // 0=idle, 1=long, -1=short
var float pendingSL         = na
var float pendingTP         = na
var float pendingEntry      = na
var float pendingRUnit      = na
var bool  beActivated       = false   // true when SL moved to Break-Even
var int   currentWinStreak  = 0
var int   currentLossStreak = 0
var int   maxWinStreak      = 0
var int   maxLossStreak     = 0

// R:R Tracking
var float totalRFixed       = 0.0
var float bestTradeR        = 0.0
var float totalRTrailing    = 0.0
var int   trailWins         = 0
var int   trailLosses       = 0
var float avgRTrailing      = 0.0
var int   trailingLockedR   = 0
var int   tradeDir          = 0       // for trailing sim

// Open trade on signal
if buySignalFinal and tradeState == 0
    totalSignals += 1
    tradeState   := 1
    pendingEntry := close
    pendingSL    := sigBuySL
    pendingTP    := sigBuyTP
    pendingRUnit := close - sigBuySL
    beActivated  := false
    tradeDir     := 1
    trailingLockedR := 0

if selSignalFinal and tradeState == 0
    totalSignals += 1
    tradeState   := -1
    pendingEntry := close
    pendingSL    := sigSelSL
    pendingTP    := sigSelTP
    pendingRUnit := sigSelSL - close
    beActivated  := false
    tradeDir     := -1
    trailingLockedR := 0

// ── Smart Trailing: BE when 1R reached, then trail on new MSS ─────────────────
if tradeState == 1 and not na(pendingEntry) and pendingRUnit > 0
    currentPnlR = (high - pendingEntry) / pendingRUnit
    // Step 1: Move SL to BE when 1R hit
    if currentPnlR >= 1.0 and not beActivated
        pendingSL    := pendingEntry   // SL → Break-Even
        beActivated  := true
    // Step 2: Trail SL to new swing low on new bullish BOS (structure extends)
    if beActivated and bosBull and not na(lastSwingL)
        newTrailSL = lastSwingL - atrValue * 0.5
        if newTrailSL > pendingSL
            pendingSL := newTrailSL
    // Lock trailing R for report
    newLockedR = math.floor(currentPnlR)
    if newLockedR > trailingLockedR
        trailingLockedR := newLockedR

if tradeState == -1 and not na(pendingEntry) and pendingRUnit > 0
    currentPnlR = (pendingEntry - low) / pendingRUnit
    if currentPnlR >= 1.0 and not beActivated
        pendingSL    := pendingEntry
        beActivated  := true
    if beActivated and bosBear and not na(lastSwingH)
        newTrailSL = lastSwingH + atrValue * 0.5
        if newTrailSL < pendingSL
            pendingSL := newTrailSL
    newLockedR = math.floor(currentPnlR)
    if newLockedR > trailingLockedR
        trailingLockedR := newLockedR

// ── Outcome check — LONG ───────────────────────────────────────────────────────
if tradeState == 1 and not na(pendingTP) and not na(pendingSL)
    if high >= pendingTP
        totalWins        += 1
        currentWinStreak += 1
        currentLossStreak := 0
        maxWinStreak     := math.max(maxWinStreak, currentWinStreak)
        tradeState       := 0
        earnedR           = (pendingTP - pendingEntry) / pendingRUnit
        totalRFixed      += earnedR
        finalTrailR       = math.max(float(trailingLockedR), earnedR)
        totalRTrailing   += finalTrailR
        bestTradeR       := math.max(bestTradeR, finalTrailR)
        trailWins        += 1
        tradeDir         := 0
        label.new(bar_index, high, "W",
             color=color.new(#4caf50, 20), textcolor=color.white,
             style=label.style_circle, size=size.tiny)
    else if low <= pendingSL
        totalLosses      += 1
        currentLossStreak += 1
        currentWinStreak  := 0
        maxLossStreak    := math.max(maxLossStreak, currentLossStreak)
        tradeState       := 0
        fixedR            = beActivated ? 0.0 : -1.0   // BE = 0R, raw SL = -1R
        totalRFixed      += fixedR
        trailingResult    = trailingLockedR > 0 ? float(trailingLockedR - 1) : -1.0
        totalRTrailing   += trailingResult
        if trailingResult >= 0.0
            trailWins    += 1
        else
            trailLosses  += 1
        tradeDir         := 0
        label.new(bar_index, low, beActivated ? "BE" : "L",
             color=color.new(beActivated ? #ffeb3b : #f44336, 20), textcolor=color.white,
             style=label.style_circle, size=size.tiny)

// ── Outcome check — SHORT ──────────────────────────────────────────────────────
if tradeState == -1 and not na(pendingTP) and not na(pendingSL)
    if low <= pendingTP
        totalWins        += 1
        currentWinStreak += 1
        currentLossStreak := 0
        maxWinStreak     := math.max(maxWinStreak, currentWinStreak)
        tradeState       := 0
        earnedR           = (pendingEntry - pendingTP) / pendingRUnit
        totalRFixed      += earnedR
        finalTrailR       = math.max(float(trailingLockedR), earnedR)
        totalRTrailing   += finalTrailR
        bestTradeR       := math.max(bestTradeR, finalTrailR)
        trailWins        += 1
        tradeDir         := 0
        label.new(bar_index, low, "W",
             color=color.new(#4caf50, 20), textcolor=color.white,
             style=label.style_circle, size=size.tiny)
    else if high >= pendingSL
        totalLosses      += 1
        currentLossStreak += 1
        currentWinStreak  := 0
        maxLossStreak    := math.max(maxLossStreak, currentLossStreak)
        tradeState       := 0
        fixedR            = beActivated ? 0.0 : -1.0
        totalRFixed      += fixedR
        trailingResult    = trailingLockedR > 0 ? float(trailingLockedR - 1) : -1.0
        totalRTrailing   += trailingResult
        if trailingResult >= 0.0
            trailWins    += 1
        else
            trailLosses  += 1
        tradeDir         := 0
        label.new(bar_index, high, beActivated ? "BE" : "L",
             color=color.new(beActivated ? #ffeb3b : #f44336, 20), textcolor=color.white,
             style=label.style_circle, size=size.tiny)

// =============================================================================
// ─── 14. DASHBOARD ────────────────────────────────────────────────────────────
// =============================================================================

winRate      = totalSignals > 0 ? (totalWins / totalSignals) * 100 : 0.0
winRateStr   = str.tostring(math.round(winRate, 1)) + "%"
avgRTrailing := totalSignals > 0 ? totalRTrailing / totalSignals : 0.0
trailWinRate  = (trailWins + trailLosses) > 0 ? (trailWins / (trailWins + trailLosses)) * 100 : 0.0

posMap(p) =>
    if p == "Top Right"      position.top_right
    else if p == "Top Left"  position.top_left
    else if p == "Bottom Left" position.bottom_left
    else position.bottom_right

trendStr = trend ==  1 ? "Bullish ↑" : trend == -1 ? "Bearish ↓" : "Neutral"
trendClr = trend ==  1 ? #4caf50     : trend == -1 ? #f44336     : #9e9e9e
sessStr  = inNY ? "🕐 NY Open" : inLondon ? "🕑 London" : inAsian ? "🌙 Asian" : "💤 Off Hours"
sessClr  = inNY ? #00bcd4 : inLondon ? #3f51b5 : inAsian ? #607d8b : #555555
volStr   = isVolatile ? "✅ Active" : "❌ Choppy"
volClr   = isVolatile ? #4caf50 : #f44336
winRateClr = winRate >= 55 ? #4caf50 : winRate >= 40 ? #ffeb3b : #f44336

activeSig    = tradeState == 1 ? "LONG 📈" : tradeState == -1 ? "SHORT 📉" : "—"
activeSigClr = tradeState == 1 ? #4caf50   : tradeState == -1 ? #f44336   : #777777
beStr        = tradeState != 0 and beActivated ? " [BE]" : ""

var table dash = na

if showDB and barstate.islast
    if not na(dash)
        table.delete(dash)

    dash := table.new(posMap(dbPos), 2, 26,
         border_color=color.new(#ffffff, 70), border_width=1,
         bgcolor=color.new(#0d0d14, 10),
         frame_color=color.new(#ffffff, 50), frame_width=1)

    // ── Header ──────────────────────────────────────────────────────────────
    table.cell(dash, 0, 0, "ICT Suite v3.1",
         text_color=#ffffff, text_size=size.small,
         bgcolor=color.new(#1a1a2e, 10), text_halign=text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker + " / " + timeframe.period,
         text_color=#aaaaaa, text_size=size.small,
         bgcolor=color.new(#1a1a2e, 10), text_halign=text.align_right)

    // ── Market Conditions ────────────────────────────────────────────────────
    table.cell(dash, 0, 1, "─── MARKET ───",
         text_color=#888888, text_size=size.tiny,
         bgcolor=color.new(#0d0d1a, 30), text_halign=text.align_left)
    table.cell(dash, 1, 1, "",
         bgcolor=color.new(#0d0d1a, 30))

    table.cell(dash, 0, 2, "Session",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 2, sessStr,
         text_color=sessClr, text_size=size.tiny, text_halign=text.align_right)

    table.cell(dash, 0, 3, "Volatility",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 3, volStr,
         text_color=volClr, text_size=size.tiny, text_halign=text.align_right)

    table.cell(dash, 0, 4, "Structure",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 4, trendStr,
         text_color=trendClr, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 5, "Active OBs / FVGs",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 5, str.tostring(obCount) + " / " + str.tostring(fvgCount),
         text_color=#00bcd4, text_size=size.small, text_halign=text.align_right)

    // ── Signal Engine (v3.1 Core+Confluence) ─────────────────────────────────
    table.cell(dash, 0, 6, "─── SIGNALS v3.1 ───",
         text_color=#ffeb3b, text_size=size.tiny,
         bgcolor=color.new(#1a1500, 30), text_halign=text.align_left)
    table.cell(dash, 1, 6, "Core + Confluence",
         text_color=#ffeb3b, text_size=size.tiny,
         bgcolor=color.new(#1a1500, 30), text_halign=text.align_right)

    buyZoneStr = buyCore_Zone ? "✅" : "—"
    buyKZStr   = inKillzone   ? "✅" : "—"
    buyVolStr  = isVolatile   ? "✅" : "❌"
    table.cell(dash, 0, 7, "BUY Core (Zone|KZ|Vol)",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 7, buyZoneStr + " " + buyKZStr + " " + buyVolStr,
         text_color=buyCore ? #00e676 : #555555,
         text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 8, "BUY Confluence (HTF|Liq|MSS)",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 8,
         (buyCX ? "✅" : "—") + " " + (buyCY ? "✅" : "—") + " " + (buyCZ ? "✅" : "—"),
         text_color=buyConfluence ? #4caf50 : #555555,
         text_size=size.small, text_halign=text.align_right)

    selZoneStr = selCore_Zone ? "✅" : "—"
    selKZStr   = inKillzone   ? "✅" : "—"
    table.cell(dash, 0, 9, "SELL Core (Zone|KZ|Vol)",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 9, selZoneStr + " " + selKZStr + " " + volStr,
         text_color=selCore ? #ff5252 : #555555,
         text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 10, "SELL Confluence (HTF|Liq|MSS)",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 10,
         (selCX ? "✅" : "—") + " " + (selCY ? "✅" : "—") + " " + (selCZ ? "✅" : "—"),
         text_color=selConfluence ? #f44336 : #555555,
         text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 11, "Active Trade",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 11, activeSig + beStr,
         text_color=activeSigClr, text_size=size.small, text_halign=text.align_right)

    // ── Win Rate ─────────────────────────────────────────────────────────────
    table.cell(dash, 0, 12, "─── WIN RATE ───",
         text_color=#888888, text_size=size.tiny,
         bgcolor=color.new(#0d0d1a, 30), text_halign=text.align_left)
    table.cell(dash, 1, 12, "",
         bgcolor=color.new(#0d0d1a, 30))

    table.cell(dash, 0, 13, "Total Signals",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 13, str.tostring(totalSignals),
         text_color=#ffffff, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 14, "Wins",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 14, str.tostring(totalWins),
         text_color=#4caf50, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 15, "Losses",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 15, str.tostring(totalLosses),
         text_color=#f44336, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 16, "Win Rate",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 16, winRateStr,
         text_color=winRateClr, text_size=size.normal, text_halign=text.align_right)

    table.cell(dash, 0, 17, "Win Streak (Max)",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 17,
         str.tostring(currentWinStreak) + " (" + str.tostring(maxWinStreak) + ")",
         text_color=#4caf50, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 18, "Loss Streak (Max)",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 18,
         str.tostring(currentLossStreak) + " (" + str.tostring(maxLossStreak) + ")",
         text_color=#f44336, text_size=size.small, text_halign=text.align_right)

    // ── R:R Report ───────────────────────────────────────────────────────────
    table.cell(dash, 0, 19, "─── R:R REPORT ───",
         text_color=#ffeb3b, text_size=size.tiny,
         bgcolor=color.new(#1a1200, 30), text_halign=text.align_left)
    table.cell(dash, 1, 19, "Fixed vs Trailing",
         text_color=#ffeb3b, text_size=size.tiny,
         bgcolor=color.new(#1a1200, 30), text_halign=text.align_right)

    rFixedStr = (totalRFixed >= 0 ? "+" : "") + str.tostring(math.round(totalRFixed, 2)) + "R"
    table.cell(dash, 0, 20, "Fixed TP Total R",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 20, rFixedStr,
         text_color=totalRFixed >= 0 ? #4caf50 : #f44336,
         text_size=size.small, text_halign=text.align_right)

    rTrailStr = (totalRTrailing >= 0 ? "+" : "") + str.tostring(math.round(totalRTrailing, 2)) + "R"
    table.cell(dash, 0, 21, "Trailing Total R",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 21, rTrailStr,
         text_color=totalRTrailing >= 0 ? #00e676 : #f44336,
         text_size=size.small, text_halign=text.align_right)

    rDiff    = totalRTrailing - totalRFixed
    rDiffStr = (rDiff >= 0 ? "+" : "") + str.tostring(math.round(rDiff, 2)) + "R"
    table.cell(dash, 0, 22, "Trailing Advantage",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 22, rDiffStr,
         text_color=rDiff >= 0 ? #00bcd4 : #ff9800,
         text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 23, "Avg R (Trailing)",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 23,
         str.tostring(math.round(avgRTrailing, 2)) + "R / trade",
         text_color=#ffffff, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 24, "Best Trade R",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 24, str.tostring(math.round(bestTradeR, 1)) + "R",
         text_color=#ffeb3b, text_size=size.small, text_halign=text.align_right)

    liveRStr = tradeState != 0 ? str.tostring(trailingLockedR) + "R locked" : "—"
    table.cell(dash, 0, 25, "Live Locked R",
         text_color=#aaaaaa, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 25, liveRStr,
         text_color=tradeState != 0 ? #00e676 : #555555,
         text_size=size.small, text_halign=text.align_right)

// =============================================================================
// END — ICT Suite v3.1
// =============================================================================
